---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Live dabei"
  description="Ich schreib dir, wenn ich irgendwo ankomme, wo es sich lohnt. Neue Orte, Food-Spots, ehrliche Eindrücke."
>

  <!-- HERO -->
  <div class="nl-hero">
    <div class="nl-hero-inner">

      <!-- Route-Deko oben -->
      <div class="nl-route-line" aria-hidden="true">
        <span class="nl-route-dot nl-route-dot--left"></span>
        <span class="nl-route-connector"></span>
        <span class="nl-route-dot nl-route-dot--center">
          <span class="nl-route-pulse"></span>
        </span>
        <span class="nl-route-connector"></span>
        <span class="nl-route-dot nl-route-dot--right"></span>
      </div>

      <h1 class="nl-headline">
        Direkt dabei,<br class="nl-br" />
        wenn ich irgendwo lande.
      </h1>

      <p class="nl-sub">
        Ich schreib dir, wenn ich irgendwo angekommen bin, wo es sich lohnt. Neue Orte, Food-Spots,
        ehrliche Eindrücke. Kein fester Rhythmus, kein Spam.
      </p>

      <!-- FORM -->
      <form class="nl-form" id="nl-form" novalidate>
        <div class="nl-field">
          <input
            type="email"
            name="email"
            id="nl-email"
            placeholder="deine@email.de"
            autocomplete="email"
            required
            class="nl-input"
          />
          <button type="submit" class="nl-btn" id="nl-btn">
            <span class="nl-btn-text">Dabei sein →</span>
            <span class="nl-btn-spinner" aria-hidden="true"></span>
          </button>
        </div>
      </form>

      <!-- SUCCESS -->
      <div class="nl-success" id="nl-success" aria-live="polite">
        <div class="nl-success-icon">✓</div>
        <div>
          <strong>Du bist dabei!</strong>
          <p>Check dein Postfach. Du bekommst gleich eine Bestätigungsmail.</p>
        </div>
      </div>

      <!-- ERROR -->
      <div class="nl-error" id="nl-error" aria-live="polite"></div>


    </div>
  </div>

  <!-- ROUTE PREVIEW -->
  <div class="nl-route">
    <div class="nl-route-inner">
      <p class="nl-route-label">Die Reise startet</p>
      <h2 class="nl-route-title">9. Juni 2026 · Solingen nach Bangkok</h2>
      <p class="nl-route-text">
        Danach geht es so lange durch Asien und die Welt, wie es eben geht. Kein festes Enddatum,
        kein fertiger Plan. Wer dabei ist, kriegt alles mit, sobald es passiert.
      </p>
      <div class="nl-route-stops">
        <div class="nl-stop">
          <span class="nl-stop-flag">🇹🇭</span>
          <span class="nl-stop-name">Thailand</span>
          <span class="nl-stop-hint">Erster Stop</span>
        </div>
        <div class="nl-stop-arrow">→</div>
        <div class="nl-stop">
          <span class="nl-stop-flag">🌏</span>
          <span class="nl-stop-name">Asien</span>
          <span class="nl-stop-hint">Weiteres offen</span>
        </div>
        <div class="nl-stop-arrow">→</div>
        <div class="nl-stop">
          <span class="nl-stop-flag">🗺️</span>
          <span class="nl-stop-name">Welt</span>
          <span class="nl-stop-hint">Mal sehen</span>
        </div>
      </div>
      <a href="/route" class="nl-route-link">Route & Karte ansehen →</a>
    </div>
  </div>


</Layout>

<script>
  function initForm(formId: string, inputId: string, btnId: string, successId: string, errorId: string) {
    const form    = document.getElementById(formId) as HTMLFormElement | null;
    const input   = document.getElementById(inputId) as HTMLInputElement | null;
    const btn     = document.getElementById(btnId) as HTMLButtonElement | null;
    const success = document.getElementById(successId);
    const errorEl = document.getElementById(errorId);
    if (!form || !input || !btn || !success || !errorEl) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      errorEl.textContent = '';
      errorEl.classList.remove('visible');

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errorEl.textContent = 'Bitte gib eine gültige E-Mail-Adresse ein.';
        errorEl.classList.add('visible');
        input.focus();
        return;
      }

      btn.disabled = true;
      btn.classList.add('loading');

      try {
        const res  = await fetch('/api/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();

        if (data.success) {
          form.style.display = 'none';
          success.classList.add('visible');
        } else {
          errorEl.textContent = data.error || 'Etwas ist schiefgelaufen. Versuch es nochmal.';
          errorEl.classList.add('visible');
          btn.disabled = false;
          btn.classList.remove('loading');
        }
      } catch {
        errorEl.textContent = 'Keine Verbindung. Bitte versuch es nochmal.';
        errorEl.classList.add('visible');
        btn.disabled = false;
        btn.classList.remove('loading');
      }
    });
  }

  initForm('nl-form', 'nl-email', 'nl-btn', 'nl-success', 'nl-error');
</script>

<style>
  /* ── HERO ── */
  .nl-hero {
    background: linear-gradient(160deg, #0F172A 0%, #1E293B 100%);
    padding: 5rem 1.5rem 5.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .nl-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(249,115,22,0.12) 0%, transparent 65%);
    pointer-events: none;
  }
  .nl-hero-inner {
    max-width: 620px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Route decoration */
  .nl-route-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-bottom: 2rem;
  }
  .nl-route-connector {
    width: 48px;
    height: 2px;
    background: rgba(249,115,22,0.35);
    border-radius: 1px;
  }
  .nl-route-dot--left,
  .nl-route-dot--right {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(249,115,22,0.4);
  }
  .nl-route-dot--center {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #F97316;
    box-shadow: 0 0 0 4px rgba(249,115,22,0.2);
    margin: 0 4px;
  }
  .nl-route-pulse {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid rgba(249,115,22,0.4);
    animation: nlpulse 2s ease-in-out infinite;
  }
  @keyframes nlpulse {
    0%,100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.5); opacity: 0; }
  }

  .nl-headline {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -.04em;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .nl-br { display: block; }

  .nl-sub {
    font-size: 1rem;
    color: #94A3B8;
    line-height: 1.75;
    max-width: 480px;
    margin: 0 auto 2.5rem;
  }

  /* FORM */
  .nl-form { display: flex; flex-direction: column; gap: .6rem; max-width: 460px; margin: 0 auto; }
  .nl-field { display: flex; gap: .5rem; }
  .nl-input {
    flex: 1;
    padding: .85rem 1.1rem;
    border: 1.5px solid rgba(255,255,255,0.12);
    border-radius: 100px;
    font-size: .92rem;
    font-family: inherit;
    color: #0F172A;
    background: white;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
    min-width: 0;
  }
  .nl-input::placeholder { color: #94A3B8; }
  .nl-input:focus {
    border-color: #F97316;
    box-shadow: 0 0 0 3px rgba(249,115,22,0.2);
  }
  .nl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    padding: .85rem 1.6rem;
    background: #F97316;
    color: white;
    border: none;
    border-radius: 100px;
    font-size: .92rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background .15s, transform .15s, box-shadow .15s;
    min-height: 48px;
  }
  .nl-btn:hover:not(:disabled) {
    background: #EA6D10;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(249,115,22,0.4);
  }
  .nl-btn:disabled { opacity: .7; cursor: not-allowed; transform: none; }
  .nl-btn-spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: white;
    border-radius: 50%;
    animation: spin .6s linear infinite;
  }
  .nl-btn.loading .nl-btn-text    { display: none; }
  .nl-btn.loading .nl-btn-spinner { display: block; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .nl-form-hint {
    font-size: .75rem;
    color: rgba(148,163,184,0.8);
    text-align: center;
  }

  /* SUCCESS */
  .nl-success {
    display: none;
    align-items: center;
    gap: .85rem;
    background: rgba(16,185,129,0.12);
    border: 1.5px solid rgba(16,185,129,0.3);
    border-radius: 14px;
    padding: 1rem 1.25rem;
    max-width: 460px;
    margin: 0 auto;
    text-align: left;
  }
  .nl-success.visible { display: flex; }
  .nl-success-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #10B981;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .nl-success strong { font-size: .95rem; color: #A7F3D0; display: block; margin-bottom: .2rem; }
  .nl-success p { font-size: .82rem; color: #6EE7B7; margin: 0; }

  /* ERROR */
  .nl-error {
    display: none;
    font-size: .82rem;
    color: #FCA5A5;
    background: rgba(239,68,68,0.1);
    border: 1.5px solid rgba(239,68,68,0.25);
    border-radius: 10px;
    padding: .65rem 1rem;
    max-width: 460px;
    margin: 0 auto;
    text-align: left;
  }
  .nl-error.visible { display: block; }

  /* ── ROUTE PREVIEW ── */
  .nl-route {
    background: linear-gradient(135deg, #FFF7ED 0%, #FFFBF5 100%);
    border-top: 1px solid #FDBA74;
    border-bottom: 1px solid #FDBA74;
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .nl-route-inner { max-width: 680px; margin: 0 auto; }
  .nl-route-label {
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: #F97316;
    margin-bottom: .6rem;
  }
  .nl-route-title {
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -.03em;
    color: #0F172A;
    margin-bottom: .75rem;
  }
  .nl-route-text {
    font-size: .95rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .nl-route-stops {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .nl-stop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .2rem;
    background: white;
    border: 1.5px solid #FDBA74;
    border-radius: 12px;
    padding: .75rem 1.1rem;
    min-width: 90px;
  }
  .nl-stop-flag { font-size: 1.5rem; line-height: 1; }
  .nl-stop-name { font-size: .85rem; font-weight: 700; color: #0F172A; }
  .nl-stop-hint { font-size: .68rem; color: #94A3B8; }
  .nl-stop-arrow { font-size: 1.1rem; color: #FDBA74; font-weight: 700; }
  .nl-route-link {
    display: inline-block;
    font-size: .88rem;
    font-weight: 700;
    color: #F97316;
    text-decoration: none;
    border-bottom: 1.5px solid #FDBA74;
    padding-bottom: 1px;
    transition: color .15s;
  }
  .nl-route-link:hover { color: #EA6D10; }

  /* RESPONSIVE */
  @media (max-width: 540px) {
    .nl-hero { padding: 3.5rem 1.25rem 4rem; }
    .nl-headline { font-size: 2rem; }
    .nl-br { display: inline; }
    .nl-field { flex-direction: column; }
    .nl-btn { width: 100%; }
    .nl-route-stops { gap: .4rem; }
    .nl-stop { min-width: 75px; padding: .6rem .75rem; }
    .nl-stop-arrow { display: none; }
  }
  @media (max-width: 380px) {
    .nl-hero { padding: 2.5rem 1rem 3rem; }
    .nl-headline { font-size: 1.65rem; }
    .nl-sub { font-size: .9rem; }
    .nl-input { font-size: .9rem; padding: .7rem .9rem; }
  }
</style>
