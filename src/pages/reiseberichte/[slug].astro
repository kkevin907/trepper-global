---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const orte = await getCollection('orte', ({ data }) => !data.draft);
  return orte.map(ort => ({ params: { slug: ort.id }, props: { ort } }));
}

const { ort } = Astro.props;
const { Content } = await render(ort);
const d = ort.data;

function ml(text: string): string {
  return text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener noreferrer" class="or-inline-link">$1</a>'
  );
}

const dateFrom = new Date(d.dateFrom).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
const dateTo   = new Date(d.dateTo).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });

const costLabels = ['', 'Günstig', 'Günstig', 'Bezahlbar', 'Teuer', 'Sehr teuer'];
const costColors = ['', '#10B981',      '#22C55E', '#F97316', '#EF4444', '#DC2626'];
const costBg     = ['', '#D1FAE5',      '#DCFCE7', '#FFF7ED', '#FEE2E2', '#FFE4E4'];
const stars = '★'.repeat(Math.floor(d.rating)) + '☆'.repeat(5 - Math.floor(d.rating));

// Food spots with coordinates for map
const mapSpots = (d.foodSpots || []).filter((f: any) => f.lat && f.lon);
const mapSights = (d.sights || []).filter((s: any) => s.lat && s.lon);
const mapCenter = (d as any).mapCenter;

const mapData = JSON.stringify({
  center: mapCenter || null,
  spots: mapSpots.map((f: any) => ({
    name: f.name,
    lat: f.lat,
    lon: f.lon,
    stars: f.stars,
    area: f.area || '',
    what: f.what || '',
    link: f.link || '',
  })),
  sights: mapSights.map((s: any) => ({
    name: s.name,
    lat: s.lat,
    lon: s.lon,
    link: s.link || '',
  })),
});
---

<Layout
  title={d.title}
  description={`Ich war in ${d.title}. Was ich dort gemacht habe, wo ich gegessen habe und was sich wirklich lohnt.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": `${d.title} – Was ich dort gemacht habe`,
      "description": `Ich war in ${d.title}. Was ich dort gemacht habe, wo ich gegessen habe und was sich wirklich lohnt.`,
      "url": `https://trepper-global.de/reiseberichte/${ort.id}`,
      "datePublished": new Date(d.dateFrom).toISOString().split('T')[0],
      "dateModified": new Date(d.dateTo).toISOString().split('T')[0],
      ...(d.coverImage ? { "image": `https://trepper-global.de${d.coverImage}` } : {}),
      "author": {
        "@type": "Person",
        "@id": "https://trepper-global.de/#person",
        "name": "Kevin Trepper",
        "url": "https://trepper-global.de/about"
      },
      "publisher": {
        "@type": "Person",
        "@id": "https://trepper-global.de/#person",
        "name": "Kevin Trepper"
      },
      "about": {
        "@type": "Place",
        "name": d.title,
        "address": { "@type": "PostalAddress", "addressCountry": d.country }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": d.rating,
        "bestRating": 5,
        "worstRating": 1,
        "ratingCount": 1
      }
    })} />
  </Fragment>

  <!-- STICKY BACK -->
  <a href="/reiseberichte" class="or-sticky-back">← Alle Reiseberichte</a>

  <!-- HEADER -->
  <div class="or-header">
    <div class="or-header-inner">
      <div class="or-meta">
        <span class="or-flag">{d.flag}</span>
        <div>
          <h1 class="or-title">{d.title}</h1>
          <p class="or-country">{d.country}</p>
        </div>
      </div>
      <div class="or-chips">
        <span class="or-chip">{dateFrom}{dateFrom !== dateTo ? ` – ${dateTo}` : ''}</span>
        <span class="or-chip">{d.nights} {d.nights === 1 ? 'Nacht' : 'Nächte'}</span>
        <span class="or-chip or-chip-vibe">{d.vibe}</span>
        <span class="or-chip" style={`color:${costColors[d.costLevel]};border-color:${costColors[d.costLevel]}40;background:${costBg[d.costLevel]};`}>
          💰 {costLabels[d.costLevel]}
        </span>
        <span class="or-chip or-chip-stars" title={`${d.rating}/5`}>{stars}</span>
      </div>
    </div>
  </div>

  <div class="or-wrap">
    <div class="or-inner">
      <div class="or-grid">

        <!-- ── LINKE SPALTE ── -->
        <div class="or-main">

          {d.coverImage && (
            <div class="or-cover">
              <img src={d.coverImage} alt={`${d.title} Titelbild`} style={d.coverImagePosition ? `object-position:${d.coverImagePosition};` : undefined} />
            </div>
          )}

          <div class="or-prose reveal">
            <Content />
          </div>

          <!-- FOOD SPOTS -->
          <div class="or-section">
            <h2 class="or-section-title">🍽️ Food-Spots</h2>
            <div class="or-food-list reveal-stagger">
              {d.foodSpots.map((f: any) => (
                <div class="or-food-card">
                  <div class="or-food-header">
                    <span class="or-food-name">{f.name}</span>
                    <span class="or-food-stars">{'★'.repeat(f.stars)}{'☆'.repeat(5-f.stars)}</span>
                  </div>
                  <p class="or-food-what">{f.what}</p>
                  <div class="or-food-meta">
                    {f.area && <span class="or-food-area">📍 {f.area}</span>}
                    {f.tip  && <span class="or-food-tip">💬 {f.tip}</span>}
                  </div>
                  {f.link && (
                    <a href={f.link} target="_blank" rel="noopener noreferrer" class="or-gmaps-btn">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      Google Maps öffnen
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- STADTKARTE -->
          {mapCenter && (
            <div class="or-section reveal">
              <h2 class="or-section-title">🗺️ Karte</h2>
              <div class="or-map-wrap">
                <div class="or-map-filters" id="or-map-filters">
                  {mapSights.length > 0 && <button class="or-map-filter or-map-filter--sight active" data-type="sight">📍 Sehenswürdigkeiten</button>}
                  {mapSpots.length > 0 && <button class="or-map-filter or-map-filter--food active" data-type="food">🍽️ Food-Spots</button>}
                </div>
                <div id="or-map" class="or-map"></div>
              </div>
            </div>
          )}


        </div>

        <!-- ── RECHTE SPALTE ── -->
        <div class="or-sidebar">

          <!-- OBEN: Budget + Highlights -->
          <div class="or-sidebar-top reveal-stagger">

            <!-- BUDGET KARTE -->
            <div class="or-sidebar-card or-budget-card">
              <h3 class="or-sidebar-title">💰 Preis&shy;einschätzung</h3>
              <div class="or-budget-dots">
                {[1,2,3,4,5].map(i => (
                  <div class={`or-budget-dot ${i <= d.costLevel ? 'or-budget-dot--active' : ''}`}
                       style={i <= d.costLevel ? `background:${costColors[d.costLevel]}` : ''}></div>
                ))}
              </div>
              <div class="or-budget-label-row">
                <span class="or-budget-label" style={`color:${costColors[d.costLevel]};background:${costBg[d.costLevel]}`}>
                  {costLabels[d.costLevel]}
                </span>
                <span class="or-budget-scale">{d.costLevel} / 5</span>
              </div>
            </div>

            <!-- HIGHLIGHTS -->
            <div class="or-sidebar-card">
              <h3 class="or-sidebar-title">📍 Highlights</h3>
              <ul class="or-list">
                {d.highlights.map((h: any) => <li set:html={ml(h)} />)}
              </ul>
            </div>

          </div>

          <!-- UNTEN: Märkte, Tipps, Meiden -->
          <div class="or-sidebar-bottom reveal-stagger">

            <!-- MÄRKTE -->
            {d.markets && d.markets.length > 0 && (
              <div class="or-sidebar-card">
                <h3 class="or-sidebar-title">🛒 Märkte</h3>
                <div class="or-market-list">
                  {d.markets.map((m: any) => (
                    <div class="or-market">
                      <div class="or-market-name">{m.name}</div>
                      <div class="or-market-meta">
                        {m.type && <span class="or-market-type">{m.type}</span>}
                        {m.when && <span class="or-market-when">{m.when}</span>}
                      </div>
                      {m.tip && <p class="or-market-tip">{m.tip}</p>}
                      {m.link && (
                        <a href={m.link} target="_blank" rel="noopener noreferrer" class="or-gmaps-btn">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          Google Maps öffnen
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- TIPPS -->
            <div class="or-sidebar-card">
              <h3 class="or-sidebar-title">💡 Tipps</h3>
              <ul class="or-list">
                {d.tips.map((t: any) => <li set:html={ml(t)} />)}
              </ul>
            </div>

            <!-- BESTES VIERTEL -->
            {d.bestArea && (
              <div class="or-sidebar-card or-sidebar-card--highlight">
                <h3 class="or-sidebar-title">🏘️ Bestes Viertel</h3>
                <p class="or-sidebar-text">{d.bestArea}</p>
              </div>
            )}

            <!-- EHER MEIDEN -->
            {d.skip && d.skip.length > 0 && (
              <div class="or-sidebar-card or-sidebar-card--skip">
                <h3 class="or-sidebar-title">🚫 Eher meiden</h3>
                <ul class="or-list or-list--skip">
                  {d.skip.map((s: any) => <li set:html={ml(s)} />)}
                </ul>
              </div>
            )}

          </div>

        </div>
      </div>
    </div>
  </div>

</Layout>

<!-- Leaflet map init -->
<script define:vars={{ mapData }}>
  (function () {
    const parsed = JSON.parse(mapData);
    if (!parsed.center) return;

    function initMap() {
      if (!window.L) { setTimeout(initMap, 100); return; }

      const mapEl = document.getElementById('or-map');
      if (!mapEl) return;

      const map = L.map('or-map', { zoomControl: true, scrollWheelZoom: false, worldCopyJump: false, maxBounds: [[-85,-210],[85,210]], maxBoundsViscosity: 1.0 })
        .setView([parsed.center.lat, parsed.center.lon], 13);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19,
        noWrap: true,
      }).addTo(map);

      // Custom marker icon
      function makeIcon(color) {
        return L.divIcon({
          className: '',
          html: `<div style="
            width:32px;height:32px;border-radius:50% 50% 50% 0;
            background:${color};border:3px solid white;
            box-shadow:0 2px 8px rgba(0,0,0,0.3);
            transform:rotate(-45deg);
          "></div>`,
          iconSize: [32, 32],
          iconAnchor: [16, 32],
          popupAnchor: [0, -34],
        });
      }

      // Layer groups for filtering
      const sightLayer = L.layerGroup().addTo(map);
      const foodLayer  = L.layerGroup().addTo(map);

      // Sight markers (coral)
      (parsed.sights || []).forEach(function (sight) {
        const mapsHref = sight.link || ('https://maps.google.com/?q=' + encodeURIComponent(sight.name));
        const popup = `
          <div style="font-family:sans-serif;min-width:160px;">
            <div style="font-weight:800;font-size:13px;color:#0F172A;margin-bottom:6px;">${sight.name}</div>
            <a href="${mapsHref}" target="_blank" rel="noopener"
               style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;
                      color:#F97316;text-decoration:none;background:#FFF7ED;border:1px solid #FDBA74;
                      padding:3px 9px;border-radius:6px;">↗ Google Maps</a>
          </div>`;
        L.marker([sight.lat, sight.lon], { icon: makeIcon('#F97316') })
          .addTo(sightLayer)
          .bindPopup(popup);
      });

      // Food spot markers (black)
      const starStr = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);
      parsed.spots.forEach(function (spot) {
        const mapsHref = spot.link || ('https://maps.google.com/?q=' + encodeURIComponent(spot.name));
        const popup = `
          <div style="font-family:sans-serif;min-width:160px;">
            <div style="font-weight:800;font-size:13px;color:#0F172A;margin-bottom:2px;">${spot.name}</div>
            <div style="font-size:11px;color:#F59E0B;margin-bottom:4px;">${starStr(spot.stars)}</div>
            ${spot.area ? `<div style="font-size:11px;color:#64748B;">📍 ${spot.area}</div>` : ''}
            ${spot.what ? `<div style="font-size:11px;color:#475569;margin-top:4px;line-height:1.4;">${spot.what}</div>` : ''}
            <a href="${mapsHref}" target="_blank" rel="noopener"
               style="display:inline-flex;align-items:center;gap:4px;margin-top:8px;font-size:11px;font-weight:700;
                      color:#F97316;text-decoration:none;background:#FFF7ED;border:1px solid #FDBA74;
                      padding:3px 9px;border-radius:6px;">↗ Google Maps</a>
          </div>`;
        L.marker([spot.lat, spot.lon], { icon: makeIcon('#0F172A') })
          .addTo(foodLayer)
          .bindPopup(popup);
      });

      // Fit bounds to all markers
      const allCoords = [
        ...(parsed.sights || []).map(s => [s.lat, s.lon]),
        ...parsed.spots.map(s => [s.lat, s.lon]),
      ];
      if (allCoords.length > 0) {
        map.fitBounds(allCoords, { padding: [40, 40], maxZoom: 14 });
      }

      // Filter button logic
      document.querySelectorAll('.or-map-filter').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const type = btn.getAttribute('data-type');
          const isActive = btn.classList.contains('active');
          btn.classList.toggle('active', !isActive);
          if (type === 'sight') {
            if (!isActive) { sightLayer.addTo(map); } else { map.removeLayer(sightLayer); }
          } else if (type === 'food') {
            if (!isActive) { foodLayer.addTo(map); } else { map.removeLayer(foodLayer); }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else {
      initMap();
    }
  })();
</script>

<style>
  /* STICKY BACK */
  .or-sticky-back {
    position: fixed;
    top: 76px;
    left: 1.25rem;
    z-index: 201;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .35rem .85rem;
    border-radius: 100px;
    font-size: .78rem;
    font-weight: 700;
    color: var(--text-mid);
    background: rgba(255,255,255,0.9);
    border: 1.5px solid var(--border);
    text-decoration: none;
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0,0,0,.07);
    transition: color .15s, box-shadow .15s;
  }
  .or-sticky-back:hover { color: var(--coral); box-shadow: 0 4px 16px rgba(0,0,0,.1); }
  @media (max-width: 600px) {
    .or-sticky-back { top: 72px; left: .75rem; font-size: .72rem; padding: .28rem .7rem; }
  }

  /* HEADER */
  .or-header { background: linear-gradient(160deg,#F8FAFC 0%,#ffffff 60%); border-bottom:1px solid var(--border); padding:2.5rem 1.5rem; }
  .or-header-inner { max-width:1100px; margin:0 auto; }
  .or-back { display:inline-block; font-size:.82rem; font-weight:600; color:var(--text-mid); margin-bottom:1.25rem; text-decoration:none; transition:color .15s; }
  .or-back:hover { color:var(--coral); }
  .or-meta { display:flex; align-items:center; gap:1rem; margin-bottom:1rem; }
  .or-flag  { font-size:3.5rem; line-height:1; }
  .or-title { font-size:clamp(2rem,5vw,3rem); font-weight:800; letter-spacing:-.04em; color:var(--text); }
  .or-country { font-size:.9rem; color:var(--text-mid); margin-top:.2rem; }
  .or-chips { display:flex; flex-wrap:wrap; gap:.5rem; }
  .or-chip { display:inline-block; padding:.28rem .8rem; border-radius:100px; font-size:.75rem; font-weight:600; border:1.5px solid var(--border); background:#F8FAFC; color:var(--text-mid); white-space:nowrap; }
  .or-chip-vibe { background:var(--coral-light); color:#C2410C; border-color:var(--coral-mid); }
  .or-chip-stars { color:#F59E0B; letter-spacing:1px; }

  /* LAYOUT */
  .or-wrap  { padding:2.5rem 1.5rem 5rem; }
  .or-inner { max-width:1100px; margin:0 auto; }
  .or-grid  { display:grid; grid-template-columns:1fr 320px; gap:2.5rem; align-items:start; }

  /* MAIN */
  .or-cover { margin-bottom:2rem; border-radius:16px; overflow:hidden; }
  .or-cover img { width:100%; height:380px; object-fit:cover; border-radius:16px; }
  .or-prose { font-size:1.02rem; color:var(--text); line-height:1.9; margin-bottom:2.5rem; hyphens:auto; -webkit-hyphens:auto; overflow-wrap:break-word; max-width:640px; margin-left:auto; margin-right:auto; }
  .or-prose p { margin-bottom:1rem; }
  .or-prose p:last-child { margin-bottom:0; }
  .or-prose strong { color:var(--text); font-weight:700; }
  :global(.or-photo-hint) { display:flex; align-items:center; gap:.5rem; background:#F8FAFC; border:2px dashed var(--border); border-radius:10px; padding:.75rem 1rem; margin:1.25rem 0; font-size:.82rem; color:var(--text-light); }
  :global(.or-photo-hint em) { font-style:normal; color:var(--text-light); }
  :global(.or-inline-link) {
    color: #C2410C;
    background: #FFF7ED;
    border: 1px solid #FDBA74;
    border-radius: 4px;
    padding: 0px 5px 1px;
    font-weight: 600;
    text-decoration: none;
    transition: background .15s, border-color .15s;
    font-size: 0.94em;
  }
  :global(.or-inline-link::after) {
    content: ' ↗';
    font-size: 0.78em;
    opacity: 0.6;
    font-weight: 400;
  }
  :global(.or-inline-link:hover) { background: #FEF3C7; border-color: #FCD34D; }

  .or-section { margin-bottom:2.5rem; }
  .or-section-title { font-size:1.1rem; font-weight:800; letter-spacing:-.02em; color:var(--text); margin-bottom:1rem; padding-bottom:.6rem; border-bottom:2px solid var(--border); }

  /* FOOD */
  .or-food-list { display:flex; flex-direction:column; gap:.75rem; }
  .or-food-card { background:#ffffff; border:1.5px solid var(--border); border-radius:12px; padding:1rem 1.1rem; transition:box-shadow .15s; }
  .or-food-card:hover { box-shadow:var(--shadow); }
  .or-food-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:.3rem; }
  .or-food-name { font-size:.95rem; font-weight:700; color:var(--text); }
  .or-food-stars { color:#F59E0B; font-size:.85rem; letter-spacing:1px; }
  .or-food-what  { font-size:.85rem; color:var(--text-mid); margin-bottom:.4rem; }
  .or-food-meta  { display:flex; flex-wrap:wrap; gap:.5rem; }
  .or-food-area  { font-size:.75rem; color:var(--text-light); }
  .or-food-tip   { font-size:.75rem; color:var(--coral); font-weight:600; }

  /* GOOGLE MAPS BUTTON */
  .or-gmaps-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: .55rem;
    padding: .32rem .8rem;
    border-radius: 100px;
    font-size: .75rem;
    font-weight: 700;
    color: #1A73E8;
    background: #EBF3FD;
    border: 1.5px solid #C5D8F8;
    text-decoration: none;
    transition: background .15s, border-color .15s;
    white-space: nowrap;
  }
  .or-gmaps-btn:hover { background: #D2E7FB; border-color: #93C0F6; }

  /* MAP */
  .or-map-wrap { border-radius:14px; overflow:hidden; border:1.5px solid var(--border); }
  .or-map-filters { display:flex; gap:.5rem; padding:.65rem .75rem; background:#F8FAFC; border-bottom:1.5px solid var(--border); flex-wrap:wrap; }
  .or-map-filter {
    display:inline-flex; align-items:center; gap:.3rem;
    padding:.3rem .75rem; border-radius:100px; font-size:.72rem; font-weight:700;
    border:1.5px solid var(--border); background:#ffffff; color:var(--text-light);
    cursor:pointer; transition:all .15s; white-space:nowrap;
    opacity:.45;
  }
  .or-map-filter.active { opacity:1; }
  .or-map-filter--sight.active { background:#FFF7ED; color:#C2410C; border-color:#FDBA74; }
  .or-map-filter--food.active  { background:#F1F5F9; color:var(--text); border-color:#CBD5E1; }
  .or-map { height:380px; width:100%; }
  .or-map-legend { display:flex; gap:.6rem; flex-wrap:wrap; margin-top:.6rem; justify-content:center; }
  .or-map-legend-item { font-size:.72rem; font-weight:600; padding:.2rem .65rem; border-radius:100px; display:inline-flex; align-items:center; gap:.35rem; }
  .or-map-legend-item::before { content:''; display:inline-block; width:10px; height:10px; border-radius:50%; }
  .or-map-legend-item--sight { background:#FFF7ED; color:#C2410C; border:1.5px solid #FDBA74; }
  .or-map-legend-item--sight::before { background:#F97316; }
  .or-map-legend-item--food { background:#F8FAFC; color:var(--text-mid); border:1.5px solid var(--border); }
  .or-map-legend-item--food::before { background:#0F172A; }

  /* PHOTOS */
  .or-photo-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:.75rem; }
  .or-photo-empty { grid-column:1/-1; background:#F8FAFC; border:2px dashed var(--border); border-radius:12px; padding:2.5rem; text-align:center; font-size:.85rem; color:var(--text-light); font-weight:600; }

  /* SIDEBAR */
  .or-sidebar { display:flex; flex-direction:column; gap:1rem; }
