---
import Layout from '../layouts/Layout.astro';
import stationsData from '../data/stations.json';
import config from '../data/config.json';

const currentStation = stationsData.find(s => s.id === config.currentStationId)
  || stationsData.find(s => s.status === 'home')!;

const solingen = stationsData.find(s => s.id === 'solingen')!;

function haversine(lat1: number, lon1: number, lat2: number, lon2: number): number {
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) ** 2
    + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon/2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

const distKm = Math.round(haversine(solingen.lat, solingen.lon, currentStation.lat, currentStation.lon));
const isHome = distKm === 0;
const details = (currentStation as any).details;

const currencyNames = new Intl.DisplayNames(['de'], { type: 'currency' });
const currencyName = currencyNames.of(currentStation.currency) || currentStation.currency;

const cityMapData = JSON.stringify({
  center: { lat: currentStation.lat, lon: currentStation.lon },
  name: currentStation.name,
  spots: (details?.spots || []) as Array<{name: string; lat: number; lon: number; type: string}>,
});

// Lookup: Spot-Name → Koordinaten, für klickbare Tags
const spotsLookup: Record<string, { lat: number; lon: number }> = {};
if (details?.spots) {
  for (const sp of details.spots as Array<{name: string; lat: number; lon: number}>) {
    spotsLookup[sp.name] = { lat: sp.lat, lon: sp.lon };
  }
}
function gmapsUrl(label: string, city: string, lat?: number, lon?: number) {
  if (lat && lon) return `https://www.google.com/maps?q=${lat},${lon}`;
  return `https://www.google.com/maps/search/${encodeURIComponent(label + ' ' + city)}`;
}
---

<Layout
  title={`Gerade in ${currentStation.name}`}
  description={`Ich bin gerade in ${currentStation.name}. Was es dort zu sehen gibt, wo man gut isst und was ich davon halte.`}
>

  <!-- HEADER -->
  <div class="jt-header">
    <div class="jt-header-inner">
      <span class="jt-badge">Aktueller Standort</span>
      <h1 class="jt-title">
        <span class="jt-flag">{currentStation.flag}</span>
        {currentStation.name}
      </h1>
      <p class="jt-country">{currentStation.country}{!isHome ? ` · ${distKm.toLocaleString('de-DE')} km von Solingen` : ' · Heimat'}</p>
      <p class="jt-desc">{currentStation.description}</p>
    </div>
  </div>

  <div class="jt-wrap">
    <div class="jt-inner">

      <!-- LIVE-STRIP + KARTE -->
      <div class="jt-top-grid">

        <!-- Live-Infos -->
        <div class="jt-live-col">
          <h2 class="jt-section-title">Vor Ort</h2>
          <div class="jt-live-cards" id="jt-live"
            data-tz={currentStation.timezone}
            data-lat={currentStation.lat}
            data-lon={currentStation.lon}
            data-currency={currentStation.currency}
            data-symbol={currentStation.currencySymbol}
          >
            <div class="jt-live-card">
              <span class="jt-live-label">Lokale Uhrzeit</span>
              <span class="jt-live-val" id="jt-time">--:--:--</span>
            </div>
            <div class="jt-live-card">
              <span class="jt-live-label">Wetter</span>
              <span class="jt-live-val">
                <span id="jt-weather-icon">–</span>
                <span id="jt-weather-temp">–°C</span>
              </span>
            </div>
            <div class="jt-live-card">
              <span class="jt-live-label">Währung</span>
              <span class="jt-live-val">{currentStation.currencySymbol} {currencyName}</span>
              {currentStation.currency !== 'EUR' && (
                <span class="jt-live-sub" id="jt-rate">1 € = …</span>
              )}
            </div>
            {details?.visa && (
              <div class="jt-live-card">
                <span class="jt-live-label">Visum</span>
                <span class="jt-live-val jt-live-val--sm">{details.visa}</span>
              </div>
            )}
            {details?.language && (
              <div class="jt-live-card">
                <span class="jt-live-label">Sprache</span>
                <span class="jt-live-val jt-live-val--sm">{details.language}</span>
              </div>
            )}
          </div>
        </div>

        <!-- Karte -->
        <div class="jt-map-col">
          <h2 class="jt-section-title" style="margin-bottom:.75rem">
            <span class="jt-section-icon">🗺️</span> {currentStation.name} – Karte
          </h2>
          <div id="jetzt-city-map" style="height:300px;border-radius:14px;overflow:hidden;border:1.5px solid var(--border);"></div>
        </div>

      </div>

      {details && (
        <>
          <!-- HIGHLIGHTS -->
          <div class="jt-section">
            <h2 class="jt-section-title">
              <span class="jt-section-icon">📍</span> Must-See
            </h2>
            <div class="jt-tags">
              {details.highlights.map((h: string) => {
                const sp = spotsLookup[h];
                return (
                  <a
                    href={gmapsUrl(h, currentStation.name, sp?.lat, sp?.lon)}
                    target="_blank"
                    rel="noopener"
                    class="jt-tag jt-tag--coral"
                    title={`${h} auf Google Maps öffnen`}
                  >
                    {h} <span class="jt-tag-icon">↗</span>
                  </a>
                );
              })}
            </div>
          </div>

          <!-- ESSEN -->
          <div class="jt-section">
            <h2 class="jt-section-title">
              <span class="jt-section-icon">🍜</span> Unbedingt essen
            </h2>
            <p class="jt-must-eat-hint">Typische Gerichte von dort. Konkrete Läden zeigt die Karte oben.</p>
            <div class="jt-tags">
              {details.mustEat.map((e: string) => (
                <span class="jt-tag jt-tag--green">{e}</span>
              ))}
            </div>
          </div>

          <!-- BESTE FÜR -->
          {details.bestFor && details.bestFor.length > 0 && (
            <div class="jt-section">
              <h2 class="jt-section-title">
                <span class="jt-section-icon">✨</span> Gut wenn du...
              </h2>
              <div class="jt-tags">
                {details.bestFor.map((b: string) => (
                  <span class="jt-tag jt-tag--blue">{b}</span>
                ))}
              </div>
            </div>
          )}

          <!-- TIPPS -->
          {details.tips && (
            <div class="jt-section">
              <h2 class="jt-section-title">
                <span class="jt-section-icon">💡</span> Tipps
              </h2>
              <p class="jt-tips">{details.tips}</p>
            </div>
          )}
        </>
      )}

      <!-- LOGBUCH-LINK -->
      <div class="jt-logbook-cta">
        <div>
          <p class="jt-cta-label">Tagebuch</p>
          <p class="jt-cta-text">Alle Einträge aus {currentStation.name} lesen</p>
        </div>
        <a href="/logbook" class="jt-cta-btn">Zum Logbuch →</a>
      </div>

    </div>
  </div>

</Layout>

<script is:inline>
(function () {
  var el = document.getElementById('jt-live');
  if (!el) return;

  var tz       = el.getAttribute('data-tz') || 'Europe/Berlin';
  var lat      = el.getAttribute('data-lat');
  var lon      = el.getAttribute('data-lon');
  var currency = el.getAttribute('data-currency');
  var symbol   = el.getAttribute('data-symbol');

  // Uhrzeit
  var timeEl = document.getElementById('jt-time');
  if (timeEl) {
    var fmt = new Intl.DateTimeFormat('de-DE', {
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      timeZone: tz, hour12: false
    });
    function tick() { timeEl.textContent = fmt.format(new Date()); }
    tick();
    setInterval(tick, 1000);
  }

  // Wetter
  if (lat && lon) {
    var wmoMap = {
      0:'☀️',1:'🌤️',2:'⛅',3:'☁️',45:'🌫️',48:'🌫️',
      51:'🌦️',53:'🌦️',55:'🌦️',61:'🌧️',63:'🌧️',65:'🌧️',
      71:'🌨️',73:'🌨️',75:'❄️',80:'🌦️',81:'🌧️',82:'⛈️',95:'⛈️',99:'⛈️'
    };
    fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon + '&current=temperature_2m,weather_code&timezone=auto')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var iconEl = document.getElementById('jt-weather-icon');
        var tempEl = document.getElementById('jt-weather-temp');
        if (iconEl) iconEl.textContent = wmoMap[d.current.weather_code] || '🌡️';
        if (tempEl) tempEl.textContent = Math.round(d.current.temperature_2m) + '°C';
      }).catch(function(){});
  }

  // Wechselkurs
  var rateEl = document.getElementById('jt-rate');
  if (rateEl && currency && currency !== 'EUR') {
    fetch('https://api.frankfurter.app/latest?from=EUR&to=' + currency)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var rate = d.rates && d.rates[currency];
        if (!rate) return;
        var formatted = rate >= 100
          ? Math.round(rate).toLocaleString('de-DE')
          : rate.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        rateEl.textContent = '1 € = ' + formatted + ' ' + symbol;
      }).catch(function(){});
  }
})();
</script>

<script define:vars={{ cityMapData }}>
(function () {
  var parsed = JSON.parse(cityMapData);
  var mapEl = document.getElementById('jetzt-city-map');
  if (!mapEl || !parsed.center) return;

  function initCityMap() {
    if (!window.L) { setTimeout(initCityMap, 100); return; }

    var map = L.map('jetzt-city-map', { zoomControl: true, scrollWheelZoom: false, worldCopyJump: false, maxBounds: [[-85,-210],[85,210]], maxBoundsViscosity: 1.0 });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap',
      maxZoom: 18,
    }).addTo(map);

    var popupOpts = { maxWidth: 180, className: 'jt-leaflet-popup' };

    function mapsLink(lat, lon, name) {
      return 'https://www.google.com/maps?q=' + lat + ',' + lon + '&query_place=' + encodeURIComponent(name);
    }

    function popupHtml(name, badge, badgeColor, lat, lon) {
      return '<div style="font-family:inherit;padding:2px 0">'
        + '<div style="font-size:.85rem;font-weight:700;color:#0F172A;margin-bottom:4px">' + name + '</div>'
        + '<div style="display:inline-block;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;'
        + 'padding:2px 7px;border-radius:100px;background:' + badgeColor.bg + ';color:' + badgeColor.text + ';margin-bottom:8px">'
        + badge + '</div>'
        + '<br><a href="' + mapsLink(lat, lon, name) + '" target="_blank" rel="noopener" '
        + 'style="display:inline-flex;align-items:center;gap:4px;font-size:.78rem;font-weight:700;'
        + 'color:#F97316;text-decoration:none;padding:4px 10px;border-radius:7px;'
        + 'background:#FFF7ED;border:1px solid #FDBA74;margin-top:2px">'
        + '↗ Google Maps</a>'
        + '</div>';
    }

    // Spot markers
    var sightIcon = L.divIcon({
      html: '<div style="width:11px;height:11px;border-radius:50%;background:#0EA5E9;border:2px solid white;box-shadow:0 1px 4px rgba(0,0,0,0.3);"></div>',
      className: '',
      iconSize: [11, 11],
      iconAnchor: [5, 5],
    });
    var foodIcon = L.divIcon({
      html: '<div style="width:11px;height:11px;border-radius:50%;background:#10B981;border:2px solid white;box-shadow:0 1px 4px rgba(0,0,0,0.3);"></div>',
      className: '',
      iconSize: [11, 11],
      iconAnchor: [5, 5],
    });

    var allMarkers = [];

    parsed.spots.forEach(function (spot) {
      var isFood = spot.type === 'food';
      var icon   = isFood ? foodIcon : sightIcon;
      var badge  = isFood ? '🍜 Essen-Tipp' : '📍 Sehenswürdigkeit';
      var color  = isFood
        ? { bg: '#D1FAE5', text: '#065F46' }
        : { bg: '#E0F2FE', text: '#0369A1' };
      var m = L.marker([spot.lat, spot.lon], { icon: icon });
      m.bindPopup(popupHtml(spot.name, badge, color, spot.lat, spot.lon), popupOpts);
      m.addTo(map);
      allMarkers.push(m);
    });

    // Zoom auf alle Pins
    var group = L.featureGroup(allMarkers);
    map.fitBounds(group.getBounds(), { padding: [28, 28] });
  }

  initCityMap();
})();
</script>

<style>
  /* HEADER */
  .jt-header {
    background: linear-gradient(160deg, #FFF7ED 0%, #ffffff 60%);
    border-bottom: 1px solid var(--border);
    padding: 3.5rem 1.5rem 3rem;
  }
  .jt-header-inner { max-width: 1100px; margin: 0 auto; }

  .jt-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--coral-light);
    color: #C2410C;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    padding: .3rem .9rem;
    border-radius: 100px;
    margin-bottom: 1.1rem;
    border: 1.5px solid var(--coral-mid);
  }
  .jt-badge::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--coral); animation: livepulse 2s ease-in-out infinite; }
  @keyframes livepulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(249,115,22,.4); }
    50%      { box-shadow: 0 0 0 5px rgba(249,115,22,0); }
  }

  .jt-title {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -.04em;
    color: var(--text);
    margin-bottom: .35rem;
  }
  .jt-flag  { font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1; }
  .jt-country { font-size: .9rem; color: var(--text-mid); margin-bottom: .5rem; }
  .jt-desc    { font-size: 1rem; color: var(--text-mid); line-height: 1.7; max-width: 640px; }

  /* WRAP */
  .jt-wrap  { padding: 2.5rem 1.5rem 5rem; }
  .jt-inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem; }

  /* TOP GRID */
  .jt-top-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* LIVE CARDS */
  .jt-section-title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -.02em;
    color: var(--text);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }
  .jt-section-icon { font-size: 1.1rem; }

  .jt-live-cards {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: .75rem;
  }
  .jt-live-card {
    background: #ffffff;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: .85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .jt-live-card--wide { grid-column: 1 / -1; }
  .jt-live-label {
    font-size: .62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--text-light);
  }
  .jt-live-val {
    font-size: .95rem;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 5px;
    font-variant-numeric: tabular-nums;
  }
  .jt-live-val--sm { font-size: .82rem; font-weight: 600; }
  .jt-live-sub {
    font-size: .72rem;
    color: var(--green);
    font-weight: 700;
    margin-top: 1px;
  }

  /* MAP COL */
  .jt-map-col { border-radius: 16px; overflow: hidden; }
  #jetzt-city-map { height: 300px; }
  @media (max-width: 800px) { #jetzt-city-map { height: 360px; } }

  /* SECTIONS */
  .jt-section {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .jt-tags { display: flex; flex-wrap: wrap; gap: .5rem; }
  .jt-tag {
    display: inline-block;
    padding: .35rem .85rem;
    border-radius: 100px;
    font-size: .82rem;
    font-weight: 600;
    border: 1.5px solid;
  }
  .jt-tag--coral { background: #FFF7ED; color: #C2410C; border-color: #FDBA74; }
  .jt-tag--green { background: #D1FAE5; color: #065F46; border-color: #6EE7B7; }
  .jt-tag--blue  { background: #E0F2FE; color: #0369A1; border-color: #7DD3FC; }

  a.jt-tag { transition: filter .15s, transform .15s; }
  a.jt-tag:hover { filter: brightness(.93); transform: translateY(-1px); }
  .jt-tag-icon { font-size: .7rem; opacity: .6; }

  .jt-must-eat-hint {
    font-size: .78rem;
    color: var(--text-light);
    margin-bottom: .75rem;
    font-style: italic;
  }

  .jt-tips {
    font-size: .92rem;
    color: var(--text-mid);
    line-height: 1.8;
    background: #F8FAFC;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }

  /* CTA */
  .jt-logbook-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    background: linear-gradient(135deg, #FFF7ED, #FDF4FF);
    border: 1.5px solid #FDBA74;
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
  }
  .jt-cta-label { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--coral); margin-bottom: .2rem; }
  .jt-cta-text  { font-size: .95rem; font-weight: 600; color: var(--text); }
  .jt-cta-btn {
    background: var(--coral);
    color: #fff !important;
    padding: .65rem 1.4rem;
    border-radius: 10px;
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
    transition: background .15s, transform .15s;
    flex-shrink: 0;
  }
  .jt-cta-btn:hover { background: #EA6D10; transform: translateY(-1px); }

  /* Leaflet Popup Override */
  :global(.jt-leaflet-popup .leaflet-popup-content-wrapper) {
    border-radius: 10px !important;
    box-shadow: 0 4px 16px rgba(15,23,42,0.14) !important;
    padding: 0 !important;
    border: 1.5px solid #E2E8F0 !important;
    max-width: 180px !important;
  }
  :global(.jt-leaflet-popup .leaflet-popup-content) {
    margin: 9px 11px !important;
    font-size: .8rem !important;
  }
  @media (max-width: 800px) {
    :global(.jt-leaflet-popup .leaflet-popup-content-wrapper) { max-width: 160px !important; }
    :global(.jt-leaflet-popup .leaflet-popup-content) { margin: 7px 9px !important; }
  }
  :global(.jt-leaflet-popup .leaflet-popup-tip-container) {
    margin-top: -1px;
  }

  /* RESPONSIVE */
  @media (max-width: 800px) {
    .jt-top-grid { grid-template-columns: 1fr; }
    .jt-live-cards { grid-template-columns: 1fr 1fr; }
    .jt-header { padding: 2rem 1.25rem; }
    .jt-wrap { padding: 1.5rem 1.25rem 3rem; }
  }
  @media (max-width: 480px) {
    .jt-live-cards { grid-template-columns: 1fr 1fr; }
    .jt-live-card--wide { grid-column: 1 / -1; }
    .jt-tags { gap: .4rem; }
    .jt-tag { font-size: .75rem; padding: .3rem .7rem; }
    .jt-section-title { font-size: .95rem; }
    .jt-logbook-cta { flex-direction: column; align-items: flex-start; }
    .jt-cta-btn { width: 100%; text-align: center; justify-content: center; }
  }
  @media (max-width: 380px) {
    .jt-header { padding: 1.5rem 1rem; }
    .jt-wrap { padding: 1.25rem 1rem 3rem; }
    .jt-live-cards { grid-template-columns: 1fr; }
    .jt-title { font-size: 1.8rem; }
    .jt-tag { font-size: .7rem; }
  }
</style>
