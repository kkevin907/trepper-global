---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---

<Layout title="Über mich" description="Wer ich bin und warum ich das mache.">
  <div class="page-header">
    <div class="page-header-inner">
      <span class="page-badge">Über mich</span>
      <h1 class="page-title">Wer ist hier unterwegs?</h1>
    </div>
  </div>

  <div class="about-wrap">
    <div class="about-inner">
      <div class="about-grid">

        <!-- PHOTO -->
        <div class="photo-wrap">
          <div class="photo-img-wrap">
            <img src="/images/kevin-about.jpeg" alt="Kevin Trepper in Lissabon" class="photo-img" />
            <div class="photo-location-badge">📍 Lissabon, Portugal</div>
          </div>

          <!-- KURZPROFIL -->
          <div class="quick-profile">
            <div class="qp-row">
              <span class="qp-label">Alter</span>
              <span class="qp-val" id="about-age">–</span>
            </div>
            <div class="qp-row">
              <span class="qp-label">Heimat</span>
              <span class="qp-val">Solingen, DE</span>
            </div>
            <div class="qp-row">
              <span class="qp-label">Erster Solotrip</span>
              <span class="qp-val">2023 · Gijón</span>
            </div>
            <div class="qp-row">
              <span class="qp-label">Abflug</span>
              <span class="qp-val qp-val--coral">9. Juni 2026</span>
            </div>
          </div>

          <div class="photo-card-ig">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            <a href="https://instagram.com/kevin.ontour" target="_blank" rel="noopener">Instagram</a>
            <span style="color:var(--border);">·</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            <a href="https://tiktok.com/@kevin.ontour" target="_blank" rel="noopener">TikTok</a>
          </div>
        </div>

        <!-- TEXT -->
        <div class="about-text">
          <h2 class="about-name">Kevin Trepper</h2>

          <div class="about-body">
            <p>
              2023 habe ich Abitur gemacht. Kurz vor der mündlichen Spanischprüfung bin ich spontan solo nach Gijón gefahren,
              um die Sprache direkt vor Ort zu üben. Das war mein erster Solotrip.
            </p>
            <p>
              Nach dem Abi habe ich direkt eine Ausbildung im E-Commerce angefangen, sie in unter zwei Jahren abgeschlossen
              und danach Vollzeit gearbeitet. Ende Mai 2026 läuft mein Vertrag aus.
              Ich habe mich entschieden, den Plan nicht weiterzuführen. Stattdessen mache ich das,
              was ich schon nach dem Abi machen wollte: mehrere Monate am Stück reisen, ohne Zeitlimit, ohne feste Pläne.
            </p>
            <p>
              Ich schreibe das hier auf, damit ich es nicht vergesse. Was ich gemacht habe, wo ich gegessen habe und was sich wirklich lohnt.
            </p>
          </div>

          <NewsletterSignup variant="inline" />

          <div class="about-cta">
            <a href="/route" class="btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              Route ansehen
            </a>
            <a href="/orte" class="btn-secondary">
              Alle Reiseberichte
            </a>
            <a href="https://instagram.com/kevin.ontour" target="_blank" rel="noopener" class="btn-ig">
              Instagram
            </a>
            <a href="https://tiktok.com/@kevin.ontour" target="_blank" rel="noopener" class="btn-ig">
              TikTok
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    background: linear-gradient(160deg, #FDF4FF 0%, #ffffff 60%);
    border-bottom: 1px solid var(--border);
    padding: 3.5rem 1.5rem 3rem;
  }
  .page-header-inner { max-width: 1100px; margin: 0 auto; }

  .page-badge {
    display: inline-block;
    background: var(--purple-light);
    color: #6D28D9;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    margin-bottom: 1rem;
  }
  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .about-wrap { padding: 3rem 1.5rem 5rem; }
  .about-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* ── PHOTO COL ── */
  .photo-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .photo-img-wrap {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(15,23,42,0.15);
    border: 3px solid white;
    outline: 1px solid var(--border);
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: 60% 58%;
    transform: scale(1.35);
    transform-origin: 60% 60%;
    display: block;
  }
  .photo-location-badge {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15,23,42,0.75);
    backdrop-filter: blur(8px);
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 100px;
    white-space: nowrap;
    border: 1px solid rgba(255,255,255,0.15);
  }

  /* KURZPROFIL */
  .quick-profile {
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .qp-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.82rem;
  }
  .qp-row:last-child { border-bottom: none; }
  .qp-label { color: var(--text-light); font-weight: 500; }
  .qp-val { color: var(--text); font-weight: 600; text-align: right; }
  .qp-val--coral { color: var(--coral); }

  .photo-card-ig {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-mid);
    padding: 0.65rem 1rem;
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .photo-card-ig a { color: #E1306C; font-weight: 700; text-decoration: none; }
  .photo-card-ig a::after { content: ' ↗'; font-size: .75em; opacity: .6; font-weight: 400; }
  .photo-card-ig a:hover { text-decoration: underline; }

  /* ── TEXT COL ── */
  .about-name {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
  }
  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-mid);
    margin-bottom: 1.5rem;
  }

  /* CTA */
  .about-cta { display: flex; gap: 0.65rem; flex-wrap: wrap; margin-top: 1.75rem; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--coral);
    color: white;
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 700;
    font-family: inherit;
    transition: all 0.15s;
  }
  .btn-primary:hover {
    background: #EA6D10;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(249,115,22,0.3);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 700;
    font-family: inherit;
    background: var(--bg-soft);
    color: var(--text);
    border: 1.5px solid var(--border);
    transition: all 0.15s;
  }
  .btn-secondary:hover { border-color: #CBD5E1; transform: translateY(-1px); }
  .btn-ig {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 700;
    font-family: inherit;
    background: transparent;
    color: #E1306C;
    border: 1.5px solid #E1306C;
    transition: all 0.15s;
  }
  .btn-ig:hover { background: #FFF0F5; }

  @media (max-width: 700px) {
    .about-grid { grid-template-columns: 1fr; }
    .photo-img { aspect-ratio: 4/3; object-position: 50% 75%; transform: none; }
    .about-body { font-size: 0.95rem; }
    .about-cta { flex-direction: column; margin-top: 1.25rem; }
    .about-cta a { justify-content: center; width: 100%; }
    .about-name { font-size: 1.8rem; }
    .about-wrap { padding: 2rem 1.25rem 3rem; }
    .page-header { padding: 2rem 1.25rem; }
  }
  @media (max-width: 480px) {
    .about-body { font-size: 0.9rem; }
    .about-name { font-size: 1.6rem; }
    .about-wrap { padding: 1.75rem 1.1rem 3rem; }
  }
  @media (max-width: 380px) {
    .about-wrap { padding: 1.5rem 1rem 2.5rem; }
    .page-header { padding: 1.5rem 1rem; }
    .about-name { font-size: 1.5rem; }
    .qp-row { padding: .45rem .75rem; font-size: .78rem; }
  }
</style>

<script is:inline>
  (function () {
    var bday = new Date('2005-03-21');
    var today = new Date();
    var age = today.getFullYear() - bday.getFullYear();
    if (today < new Date(today.getFullYear(), bday.getMonth(), bday.getDate())) age--;
    var el = document.getElementById('about-age');
    if (el) el.textContent = age + ' Jahre';
  })();
</script>
