---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const orte = await getCollection('orte', ({ data }) => !data.draft);

// Echte Berichte (kein TODO in highlights[0]) zuerst, dann nach Datum absteigend
const hasRealContent = (o: typeof orte[0]) => !o.data.highlights[0].startsWith('TODO');
orte.sort((a, b) => {
  const aReal = hasRealContent(a) ? 1 : 0;
  const bReal = hasRealContent(b) ? 1 : 0;
  if (bReal !== aReal) return bReal - aReal;
  return new Date(b.data.dateFrom).getTime() - new Date(a.data.dateFrom).getTime();
});

const costColors  = ['', '#10B981', '#22C55E', '#F97316', '#EF4444', '#DC2626'];
const costLabels  = ['', 'Günstig', 'Günstig', 'Bezahlbar', 'Teuer', 'Sehr teuer'];
---

<Layout
  title="Orte"
  description="Alle Orte wo ich war. Was sich gelohnt hat, was nicht und wo man gut essen kann."
>

  <a href="/" class="oi-sticky-back">← Zurück</a>

  <div class="oi-header">
    <div class="oi-header-inner">
      <h1 class="oi-title reveal">Meine Orte</h1>
      <p class="oi-sub reveal">Jeder Ort. Ehrlich bewertet.</p>
    </div>
  </div>

  <div class="oi-wrap">
    <div class="oi-inner">

      {orte.length === 0 ? (
        <div class="oi-empty">
          <p>Noch keine Berichte veröffentlicht.</p>
        </div>
      ) : (
        <div class="oi-grid reveal-stagger">
          {orte.map(ort => {
            const d = ort.data;
            const isReal   = !d.highlights[0].startsWith('TODO');
            const Tag      = isReal ? 'a' : 'div';
            const props    = isReal ? { href: `/orte/${ort.id}` } : {};

            return (
              <Tag {...props} class={`oi-card${isReal ? ' oi-card--link' : ' oi-card--soon'}`}>
                {d.coverImage ? (
                  <div class="oi-card-img">
                    <img src={d.coverImage} alt={d.title} />
                  </div>
                ) : (
                  <div class="oi-card-img oi-card-img--empty">
                    <span class="oi-card-flag">{d.flag}</span>
                    {!isReal && <span class="oi-coming-soon">Bericht folgt</span>}
                  </div>
                )}
                <div class="oi-card-body">
                  <div class="oi-card-meta">
                    <span class="oi-card-country">{d.country}</span>
                    <span class="oi-card-date">{new Date(d.dateFrom).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' })}</span>
                  </div>
                  <h2 class="oi-card-title">{d.title}</h2>
                  <div class="oi-card-chips">
                    <span class="oi-chip oi-chip-vibe">{d.vibe}</span>
                    <span class="oi-chip oi-chip-cost" style={`color:${costColors[d.costLevel]};border-color:${costColors[d.costLevel]}30;background:${costColors[d.costLevel]}12;`}>
                      {costLabels[d.costLevel]}
                    </span>
                    <span class="oi-chip oi-chip-stars">{'★'.repeat(d.rating)}{'☆'.repeat(5-d.rating)}</span>
                  </div>
                </div>
                {isReal && <span class="oi-card-arrow">→</span>}
              </Tag>
            );
          })}
        </div>
      )}

    </div>
  </div>

</Layout>

<style>
  /* HEADER */
  .oi-header {
    background: linear-gradient(160deg, #F8FAFC 0%, #ffffff 60%);
    border-bottom: 1px solid var(--border);
    padding: 2.5rem 1.5rem;
  }
  .oi-header-inner { max-width: 1100px; margin: 0 auto; }

  .oi-sticky-back {
    position: fixed;
    top: 76px;
    left: 1.25rem;
    z-index: 201;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .35rem .85rem;
    border-radius: 100px;
    font-size: .78rem;
    font-weight: 700;
    color: var(--text-mid);
    background: rgba(255,255,255,0.9);
    border: 1.5px solid var(--border);
    text-decoration: none;
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0,0,0,.07);
    transition: color .15s, box-shadow .15s;
  }
  .oi-sticky-back:hover { color: var(--coral); box-shadow: 0 4px 16px rgba(0,0,0,.1); }
  @media (max-width: 600px) {
    .oi-sticky-back { top: 72px; left: .75rem; font-size: .72rem; padding: .28rem .7rem; }
  }

  .oi-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -.04em;
    color: var(--text);
    margin-bottom: .4rem;
  }
  .oi-sub {
    font-size: .95rem;
    color: var(--text-mid);
    max-width: 540px;
  }

  /* LAYOUT */
  .oi-wrap  { padding: 2.5rem 1.5rem 5rem; }
  .oi-inner { max-width: 1100px; margin: 0 auto; }

  .oi-empty {
    text-align: center;
    padding: 4rem;
    color: var(--text-light);
    font-size: .9rem;
  }

  /* GRID */
  .oi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  /* CARD */
  .oi-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1.5px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    position: relative;
    transition: box-shadow .2s, transform .2s, border-color .2s;
  }
  .oi-card--link:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,.08);
    transform: translateY(-2px);
    border-color: var(--coral-mid);
  }
  .oi-card--soon {
    opacity: .6;
    cursor: default;
  }

  .oi-card-img {
    height: 200px;
    overflow: hidden;
    background: #F1F5F9;
  }
  .oi-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s;
  }
  .oi-card--link:hover .oi-card-img img { transform: scale(1.04); }

  .oi-card-img--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #F8FAFC, #F1F5F9);
    position: relative;
  }
  .oi-card-flag { font-size: 3rem; }

  .oi-card-body { padding: 1rem 1.1rem 1rem; flex: 1; }

  .oi-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: .3rem;
  }
  .oi-card-country {
    font-size: .72rem;
    font-weight: 600;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: .05em;
  }
  .oi-card-date {
    font-size: .72rem;
    font-weight: 600;
    color: var(--text-light);
  }
  .oi-card-nights {
    font-size: .7rem;
    font-weight: 600;
    color: var(--text-light);
    background: #F1F5F9;
    padding: 2px 7px;
    border-radius: 100px;
  }

  .oi-card-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -.03em;
    color: var(--text);
    margin-bottom: .2rem;
  }
  .oi-card-dates {
    font-size: .75rem;
    color: var(--text-light);
  }

  .oi-card-arrow {
    position: absolute;
    bottom: 1rem;
    right: 1.1rem;
    font-size: .9rem;
    color: var(--coral);
    opacity: 0;
    transition: opacity .2s, transform .2s;
  }
  .oi-card--link:hover .oi-card-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  .oi-coming-soon {
    position: absolute;
    bottom: .6rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15,23,42,.45);
    color: #fff;
    font-size: .68rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 100px;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }

  .oi-card-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .6rem; }
  .oi-chip {
    display: inline-block;
    padding: .2rem .6rem;
    border-radius: 100px;
    font-size: .7rem;
    font-weight: 600;
    border: 1.5px solid var(--border);
    background: #F8FAFC;
    color: var(--text-mid);
    white-space: nowrap;
  }
  .oi-chip-vibe  { background: var(--coral-light); color: #C2410C; border-color: var(--coral-mid); }
  .oi-chip-stars { color: #F59E0B; letter-spacing: 1px; border-color: #FEF3C720; background: #FEF3C730; }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .oi-grid { grid-template-columns: 1fr; }
    .oi-header { padding: 1.75rem 1.25rem; }
    .oi-wrap { padding: 1.5rem 1.25rem 3rem; }
    .oi-card-chips { display: flex; }
    .oi-chip { font-size: .65rem; padding: .18rem .5rem; }
  }
  @media (max-width: 380px) {
    .oi-header { padding: 1.5rem 1rem; }
    .oi-wrap { padding: 1.25rem 1rem 2.5rem; }
    .oi-card-title { font-size: 1.1rem; }
  }
</style>
