      </div>

      <!-- Topbar: Standort -->
      <div class="ph-topbar">
        <LocationBadge location={currentStation.name} country={currentStation.country} flag={currentStation.flag} />
      </div>

      <!-- Kompakte Headline -->
      <div class="ph-headline-block">
        <p class="ph-eyebrow">Reise-Logbuch von Kevin</p>
        <div class="ph-title-row">
          <h1 class="ph-title">
            Von Solingen<br />
            <span class="ph-grad">in die Welt.</span>
          </h1>
          <div class="ph-chip ph-chip--inline ph-chip--countdown" id="ph-chip-countdown">
            <div class="ph-cd-units" id="ph-cd-units">
              <div class="ph-cd-unit"><span class="ph-cd-num" id="ph-cd-d">–</span><span class="ph-cd-lbl">Tage</span></div>
              <span class="ph-cd-sep">:</span>
              <div class="ph-cd-unit"><span class="ph-cd-num" id="ph-cd-h">–</span><span class="ph-cd-lbl">Std</span></div>
              <span class="ph-cd-sep">:</span>
              <div class="ph-cd-unit"><span class="ph-cd-num" id="ph-cd-m">–</span><span class="ph-cd-lbl">Min</span></div>
              <span class="ph-cd-sep">:</span>
              <div class="ph-cd-unit"><span class="ph-cd-num" id="ph-cd-s">–</span><span class="ph-cd-lbl">Sek</span></div>
            </div>
            <span class="ph-cd-label" id="ph-cd-label">bis Abflug</span>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class="ph-actions">
        <a href="/about" class="ph-btn-ghost">Über mich</a>
        <a href="/reiseberichte" class="ph-btn-ghost ph-btn-mobile-only">Reiseberichte</a>
        <a href="/route" class="ph-btn-ghost ph-btn-mobile-only">Route</a>
      </div>

      <!-- Stats -->
      <div class="ph-stats">
        <div class="ph-stat">
          <span class="ph-stat-n" style="color:#F97316;">{visitedIn2026}</span>
          <span class="ph-stat-l">Orte in 2026</span>
        </div>
        <div class="ph-stat-sep"></div>
        <div class="ph-stat">
