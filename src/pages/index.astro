---
import Layout from '../layouts/Layout.astro';
import LocationBadge from '../components/LocationBadge.astro';
import WorldMap from '../components/WorldMap.astro';
// import NewsletterSignup from '../components/NewsletterSignup.astro';
import stationsData from '../data/stations.json';
import config from '../data/config.json';
import { getCollection } from 'astro:content';

const orteEntries = await getCollection('orte', ({ data }) => !data.draft);
const realOrte = orteEntries.filter(o => !o.data.highlights[0].startsWith('TODO'));
const orteIdSet = new Set(realOrte.map(o => o.data.stationId));
const orteCount = orteIdSet.size;

// Weltreise-Berichte zuerst (aufsteigend), dann Warmup (absteigend)
const WELTREISE_START = new Date('2026-06-09');
const recentOrte = [...realOrte]
  .sort((a, b) => {
    const aDate = new Date(a.data.dateFrom);
    const bDate = new Date(b.data.dateFrom);
    const aMain = aDate >= WELTREISE_START ? 1 : 0;
    const bMain = bDate >= WELTREISE_START ? 1 : 0;
    if (bMain !== aMain) return bMain - aMain;
    if (aMain && bMain) return bDate.getTime() - aDate.getTime();
    return bDate.getTime() - aDate.getTime();
  })
  .slice(0, 4);

const costColors = ['', '#10B981', '#22C55E', '#F97316', '#EF4444', '#DC2626'];
const costLabels = ['', 'Günstig', 'Günstig', 'Bezahlbar', 'Teuer', 'Sehr teuer'];

// Alle besuchten Orte in 2026 — Warmup + Weltreise, automatisch via dateFrom
const _todayCount = new Date();
const visitedIn2026 = stationsData.filter(
  s => (s.phase === 'warmup' || s.phase === 'main') &&
       s.dateFrom &&
       new Date(s.dateFrom) <= _todayCount
).length;


// Kilometer berechnen — Haversine über alle besuchten Stationen (home + visited)
function haversine(lat1: number, lon1: number, lat2: number, lon2: number): number {
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) ** 2
    + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon/2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

// Aktueller Standort — date-basiert: aktuellste main-Station mit dateFrom <= heute
const _today = new Date();

// km zurückgelegt — nur Weltreise (phase "main"), ab Solingen, chronologisch
const home = stationsData.find(s => s.status === 'home')!;
const worldTripVisited = stationsData
  .filter(s => s.phase === 'main' && s.dateFrom && new Date(s.dateFrom) <= _today)
  .sort((a, b) => new Date(a.dateFrom!).getTime() - new Date(b.dateFrom!).getTime());

const traveled = worldTripVisited.length > 0 ? [home, ...worldTripVisited] : [];

let kmTotal = 0;
for (let i = 1; i < traveled.length; i++) {
  kmTotal += haversine(traveled[i-1].lat, traveled[i-1].lon, traveled[i].lat, traveled[i].lon);
}
const kmDisplay = kmTotal > 0
  ? Math.round(kmTotal).toLocaleString('de-DE')
  : '0';
const currentStation = stationsData
  .filter(s => s.phase === 'main' && s.dateFrom && new Date(s.dateFrom) <= _today)
  .sort((a, b) => new Date(b.dateFrom!).getTime() - new Date(a.dateFrom!).getTime())[0]
  || stationsData.find(s => s.id === config.currentStationId)
  || stationsData.find(s => s.status === 'home')!;
const solingen = stationsData.find(s => s.id === 'solingen')!;
const distKm = Math.round(haversine(solingen.lat, solingen.lon, currentStation.lat, currentStation.lon));
const distDisplay = distKm === 0 ? 'Heimat' : `${distKm.toLocaleString('de-DE')} km`;
const locTimezone = currentStation.timezone || 'Europe/Berlin';
const locCurrencyDisplay = `${currentStation.currencySymbol} ${currentStation.currency}`;
const locStationName = currentStation.name;
const locLat = currentStation.lat;
const locLon = currentStation.lon;

// Wechselkurs zur Build-Zeit fetchen
let buildTimeRateText = '';
if (currentStation.currency && currentStation.currency !== 'EUR') {
  try {
    const rateResp = await fetch('https://open.er-api.com/v6/latest/EUR');
    const rateData = await rateResp.json();
    const rate = rateData.rates?.[currentStation.currency];
    if (rate) {
      const formatted = rate >= 100
        ? Math.round(rate).toLocaleString('de-DE')
        : rate.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      buildTimeRateText = `1 € = ${formatted} ${currentStation.currencySymbol}`;
    }
  } catch (e) {}
}
---

<Layout title="Home">
<div class="pg-home">

<!-- ═══════════════════════════════════════════════════════
