<!-- ═══════════════════════════════════════════════════════
     REISEBERICHTE TEASER
═══════════════════════════════════════════════════════ -->
{recentOrte.length > 0 && (
  <section class="ph-sec ph-reports reveal">
    <div class="ph-wrap">
      <div class="ph-reports-head">
        <div>
          <p class="ph-sec-label" style="color:#10B981;">Reiseberichte</p>
          <h2 class="ph-sec-title">Was ich bisher gesehen habe.</h2>
        </div>
        <a href="/reiseberichte" class="ph-reports-all">Alle ansehen →</a>
      </div>
      <div class="ph-reports-grid">
        {recentOrte.map(ort => {
          const d = ort.data;
          const stars = '★'.repeat(Math.floor(d.rating)) + '☆'.repeat(5 - Math.floor(d.rating));
          return (
            <a href={`/reiseberichte/${ort.id}`} class="ph-report-card">
              {d.coverImage ? (
                <div class="ph-report-img">
                  <img src={d.coverImage} alt={d.title} loading="lazy" />
                </div>
              ) : (
                <div class="ph-report-img ph-report-img--empty">
                  <span style="font-size:2.5rem;">{d.flag}</span>
                </div>
              )}
              <div class="ph-report-body">
                <p class="ph-report-meta">{d.flag} {d.country}</p>
                <h3 class="ph-report-title">{d.title}</h3>
                <div class="ph-report-chips">
                  <span class="ph-report-vibe">{d.vibe}</span>
                  <span class="ph-report-cost" style={`color:${costColors[d.costLevel]}`}>{costLabels[d.costLevel]}</span>
                  <span class="ph-report-stars">{stars}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <div class="ph-reports-footer">
        <a href="/reiseberichte" class="ph-reports-cta">Alle Reiseberichte ansehen →</a>
      </div>
    </div>
  </section>
)}

