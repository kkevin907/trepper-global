<script is:inline>
(function () {
  function initTimeline() {
    var container = document.getElementById('ph-timeline');
    if (!container) return;

    var now = new Date();
    var PHUKET_DATE    = new Date('2026-06-16T00:00:00');
    var KOHTAO_DATE    = new Date('2026-06-19T00:00:00');
    var BANGKOK_DATE   = new Date('2026-06-29T00:00:00');
    var HONGKONG_DATE  = new Date('2026-07-02T00:00:00');
    var MACAU_DATE     = new Date('2026-07-09T00:00:00');
    var SHENZHEN_DATE  = new Date('2026-07-10T00:00:00');
    var SHANGHAI_DATE  = new Date('2026-07-15T00:00:00');
    var WUHAN_DATE         = new Date('2026-07-19T00:00:00');
    var ZHANGJIAJIE_DATE   = new Date('2026-07-24T00:00:00');
    var CHONGQING_DATE     = new Date('2026-07-26T00:00:00');
    var CHENGDU_DATE       = new Date('2026-07-30T00:00:00');
    var KUNMING_DATE       = new Date('2026-08-03T00:00:00');
    var SAPA_DATE          = new Date('2026-08-06T00:00:00');
    var HANOI_DATE         = new Date('2026-08-11T00:00:00');
    var CATBA_DATE         = new Date('2026-08-12T00:00:00');

    function setVisited(dotId, badgeId, stopId, label) {
      var dot   = document.getElementById(dotId);
      var badge = document.getElementById(badgeId);
      var stop  = document.getElementById(stopId);
      if (dot)   { dot.className = 'ph-tl-dot'; dot.style.cssText = 'background:#10B981;box-shadow:0 0 0 3px #10B98122;'; var p = dot.querySelector('.ph-tl-dot-pulse'); if (p) p.remove(); }
      if (badge) { badge.className = 'ph-tl-badge'; badge.style.cssText = 'background:#D1FAE5;color:#065F46;'; badge.textContent = label; }
      if (stop)  { stop.className = 'ph-tl-stop'; }
    }
    function setCurrent(dotId, badgeId, stopId) {
      var dot   = document.getElementById(dotId);
      var badge = document.getElementById(badgeId);
      var stop  = document.getElementById(stopId);
      if (dot)   { dot.className = 'ph-tl-dot ph-tl-dot--current'; dot.style.cssText = ''; var p2 = document.createElement('span'); p2.className = 'ph-tl-dot-pulse'; dot.appendChild(p2); }
      if (badge) { badge.className = 'ph-tl-badge ph-tl-badge--current'; badge.style.cssText = ''; badge.textContent = 'Jetzt hier'; }
      if (stop)  { stop.className = 'ph-tl-stop ph-tl-stop--current'; }
    }

    if (now >= PHUKET_DATE) {
      setVisited('ph-tl-kl-dot', 'ph-tl-kl-badge', 'ph-tl-kl-current', '✓ 11.–15. Jun');
      setCurrent('ph-tl-phuket-dot', 'ph-tl-phuket-badge', 'ph-tl-phuket');
    }
    if (now >= KOHTAO_DATE) {
      setVisited('ph-tl-phuket-dot', 'ph-tl-phuket-badge', 'ph-tl-phuket', '✓ 16.–18. Jun');
      setCurrent('ph-tl-kohtao-dot', 'ph-tl-kohtao-badge', 'ph-tl-kohtao');
    }
    if (now >= BANGKOK_DATE) {
      setVisited('ph-tl-kohtao-dot', 'ph-tl-kohtao-badge', 'ph-tl-kohtao', '✓ 19.–28. Jun');
      setCurrent('ph-tl-bangkok-dot', 'ph-tl-bangkok-badge', 'ph-tl-bangkok');
    }
    if (now >= HONGKONG_DATE) {
      setVisited('ph-tl-bangkok-dot', 'ph-tl-bangkok-badge', 'ph-tl-bangkok', '✓ 29. Jun–2. Jul');
      setCurrent('ph-tl-hongkong-dot', 'ph-tl-hongkong-badge', 'ph-tl-hongkong');
    }
    if (now >= MACAU_DATE) {
      setCurrent('ph-tl-macau-dot', 'ph-tl-macau-badge', 'ph-tl-macau');
    }
    if (now >= SHENZHEN_DATE) {
      setVisited('ph-tl-hongkong-dot', 'ph-tl-hongkong-badge', 'ph-tl-hongkong', '✓ 2.–10. Jul');
      setVisited('ph-tl-macau-dot', 'ph-tl-macau-badge', 'ph-tl-macau', '✓ 9. Jul');
      setCurrent('ph-tl-shenzhen-dot', 'ph-tl-shenzhen-badge', 'ph-tl-shenzhen');
    }
    if (now >= SHANGHAI_DATE) {
      setVisited('ph-tl-shenzhen-dot', 'ph-tl-shenzhen-badge', 'ph-tl-shenzhen', '✓ 10.–14. Jul');
      setCurrent('ph-tl-shanghai-dot', 'ph-tl-shanghai-badge', 'ph-tl-shanghai');
    }
    if (now >= WUHAN_DATE) {
      setVisited('ph-tl-shanghai-dot', 'ph-tl-shanghai-badge', 'ph-tl-shanghai', '✓ 15.–18. Jul');
      setCurrent('ph-tl-wuhan-dot', 'ph-tl-wuhan-badge', 'ph-tl-wuhan');
    }
    if (now >= ZHANGJIAJIE_DATE) {
      setVisited('ph-tl-wuhan-dot', 'ph-tl-wuhan-badge', 'ph-tl-wuhan', '✓ 19.–23. Jul');
      setCurrent('ph-tl-zhangjiajie-dot', 'ph-tl-zhangjiajie-badge', 'ph-tl-zhangjiajie');
    }
    if (now >= CHONGQING_DATE) {
      setVisited('ph-tl-zhangjiajie-dot', 'ph-tl-zhangjiajie-badge', 'ph-tl-zhangjiajie', '✓ 24.–26. Jul');
      setCurrent('ph-tl-chongqing-dot', 'ph-tl-chongqing-badge', 'ph-tl-chongqing');
    }
    if (now >= CHENGDU_DATE) {
      setVisited('ph-tl-chongqing-dot', 'ph-tl-chongqing-badge', 'ph-tl-chongqing', '✓ 26.–29. Jul');
      setCurrent('ph-tl-chengdu-dot', 'ph-tl-chengdu-badge', 'ph-tl-chengdu');
    }
    if (now >= KUNMING_DATE) {
      setVisited('ph-tl-chengdu-dot', 'ph-tl-chengdu-badge', 'ph-tl-chengdu', '✓ 30. Jul–2. Aug');
      setCurrent('ph-tl-kunming-dot', 'ph-tl-kunming-badge', 'ph-tl-kunming');
    }
    if (now >= SAPA_DATE) {
      setVisited('ph-tl-kunming-dot', 'ph-tl-kunming-badge', 'ph-tl-kunming', '✓ 3.–6. Aug');
      setCurrent('ph-tl-sapa-dot', 'ph-tl-sapa-badge', 'ph-tl-sapa');
    }
    if (now >= HANOI_DATE) {
      setVisited('ph-tl-sapa-dot', 'ph-tl-sapa-badge', 'ph-tl-sapa', '✓ 6.–11. Aug');
      setCurrent('ph-tl-hanoi-dot', 'ph-tl-hanoi-badge', 'ph-tl-hanoi');
    }
    if (now >= CATBA_DATE) {
      setVisited('ph-tl-hanoi-dot', 'ph-tl-hanoi-badge', 'ph-tl-hanoi', '✓ 11.–12. Aug');
      setCurrent('ph-tl-cat-ba-dot', 'ph-tl-cat-ba-badge', 'ph-tl-cat-ba');
    }

    // Aktuellen Stop zentrieren
    var ABFLUG = new Date('2026-06-09T13:45:00+02:00');
    var marker = now < ABFLUG
      ? document.getElementById('ph-tl-current')
      : now >= CATBA_DATE       ? document.getElementById('ph-tl-cat-ba')
      : now >= HANOI_DATE       ? document.getElementById('ph-tl-hanoi')
      : now >= SAPA_DATE        ? document.getElementById('ph-tl-sapa')
      : now >= KUNMING_DATE     ? document.getElementById('ph-tl-kunming')
      : now >= CHENGDU_DATE     ? document.getElementById('ph-tl-chengdu')
      : now >= CHONGQING_DATE   ? document.getElementById('ph-tl-chongqing')
      : now >= ZHANGJIAJIE_DATE ? document.getElementById('ph-tl-zhangjiajie')
      : now >= WUHAN_DATE    ? document.getElementById('ph-tl-wuhan')
      : now >= SHANGHAI_DATE ? document.getElementById('ph-tl-shanghai')
      : now >= SHENZHEN_DATE ? document.getElementById('ph-tl-shenzhen')
      : now >= MACAU_DATE    ? document.getElementById('ph-tl-macau')
      : now >= HONGKONG_DATE ? document.getElementById('ph-tl-hongkong')
      : now >= BANGKOK_DATE  ? document.getElementById('ph-tl-bangkok')
      : now >= KOHTAO_DATE   ? document.getElementById('ph-tl-kohtao')
      : now >= PHUKET_DATE   ? document.getElementById('ph-tl-phuket')
      : document.getElementById('ph-tl-kl-current');
    if (!marker) marker = document.getElementById('ph-tl-kl-current');
    if (!marker) return;

    function centerMarker() {
      var cw = container.offsetWidth;
      var ml = marker.offsetLeft;
      var mw = marker.offsetWidth;
      container.scrollLeft = ml - cw / 2 + mw / 2;
    }
    centerMarker();
    window.addEventListener('resize', centerMarker);

    // Maus-Drag
    var isDown = false, startX = 0, scrollLeft = 0;
    container.style.cursor = 'grab';

    container.addEventListener('mousedown', function (e) {
      isDown = true;
      container.style.cursor = 'grabbing';
      startX     = e.pageX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
    });
    document.addEventListener('mouseup', function () {
      isDown = false;
      container.style.cursor = 'grab';
    });
    container.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      var x = e.pageX - container.offsetLeft;
      container.scrollLeft = scrollLeft - (x - startX) * 1.5;
    });
  }

  // Wechselkurs via Frankfurter API (kostenlos, kein API-Key)
  function initExchangeRate() {
    var el = document.getElementById('ph-locinfo');
    var rateEl = document.getElementById('ph-li-rate');
    if (!el || !rateEl) return;

    var currency = el.getAttribute('data-currency');
    var symbol   = el.getAttribute('data-symbol');
    if (!currency || currency === 'EUR') return; // Heimatwährung, kein Kurs nötig

    fetch('https://open.er-api.com/v6/latest/EUR')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var rate = data.rates && data.rates[currency];
        if (!rate) return;
        var formatted = rate >= 100
          ? Math.round(rate).toLocaleString('de-DE')
          : rate.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        rateEl.textContent = '1 € = ' + formatted + ' ' + symbol;
      })
      .catch(function() {});
  }

  // Wetter via Open-Meteo (kostenlos, kein API-Key)
  function initWeather() {
    var el = document.getElementById('ph-locinfo');
    if (!el) return;
    var lat = el.getAttribute('data-lat');
    var lon = el.getAttribute('data-lon');
    if (!lat || !lon) return;

    // WMO Wettercodes → Emoji + Beschreibung
    var wmoMap = {
      0:  { e: '☀️',  t: 'Klar' },
      1:  { e: '🌤️', t: 'Meist klar' },
      2:  { e: '⛅',  t: 'Bewölkt' },
      3:  { e: '☁️',  t: 'Bedeckt' },
      45: { e: '🌫️', t: 'Nebel' },
      48: { e: '🌫️', t: 'Nebel' },
      51: { e: '🌦️', t: 'Nieselregen' },
      53: { e: '🌦️', t: 'Nieselregen' },
      55: { e: '🌦️', t: 'Nieselregen' },
      61: { e: '🌧️', t: 'Regen' },
      63: { e: '🌧️', t: 'Regen' },
      65: { e: '🌧️', t: 'Starkregen' },
      71: { e: '🌨️', t: 'Schnee' },
      73: { e: '🌨️', t: 'Schnee' },
      75: { e: '❄️',  t: 'Schneefall' },
      77: { e: '🌨️', t: 'Schneekörner' },
      80: { e: '🌦️', t: 'Schauer' },
      81: { e: '🌧️', t: 'Schauer' },
      82: { e: '⛈️',  t: 'Starke Schauer' },
      85: { e: '🌨️', t: 'Schneeschauer' },
      86: { e: '🌨️', t: 'Schneeschauer' },
      95: { e: '⛈️',  t: 'Gewitter' },
      96: { e: '⛈️',  t: 'Gewitter' },
      99: { e: '⛈️',  t: 'Schweres Gewitter' },
    };

    function fetchWeather() {
      var url = 'https://api.open-meteo.com/v1/forecast'
        + '?latitude=' + lat
        + '&longitude=' + lon
        + '&current=temperature_2m,weather_code'
        + '&timezone=auto';

      fetch(url)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var cur = data.current;
          var code = cur.weather_code;
          var temp = Math.round(cur.temperature_2m);
          var info = wmoMap[code] || { e: '🌡️', t: '' };

          var iconEl = document.getElementById('ph-weather-icon');
          var tempEl = document.getElementById('ph-weather-temp');
          if (iconEl) iconEl.textContent = info.e;
          if (tempEl) tempEl.textContent = temp + '°C';
        })
        .catch(function() {
          var tempEl = document.getElementById('ph-weather-temp');
          if (tempEl) tempEl.textContent = 'n/a';
        });
    }

    fetchWeather();
    // alle 15 Minuten aktualisieren
    setInterval(fetchWeather, 15 * 60 * 1000);
  }

  // Lokale Uhrzeit — live aktualisiert
  function initClock() {
    var el = document.getElementById('ph-locinfo');
    var timeEl = document.getElementById('ph-li-time');
    if (!el || !timeEl) return;
    var tz = el.getAttribute('data-tz') || 'Europe/Berlin';
    var fmt = new Intl.DateTimeFormat('de-DE', {
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      timeZone: tz, hour12: false
    });
    function tick() { timeEl.textContent = fmt.format(new Date()); }
    tick();
    setInterval(tick, 1000);
  }

  // Countdown: Tage/Std/Min/Sek bis Abflug, danach Tage unterwegs
  function updateCountdown() {
    var ABFLUG = new Date('2026-06-09T13:45:00+02:00');
    var now    = new Date();
    var chip   = document.getElementById('ph-chip-countdown');
    var units  = document.getElementById('ph-cd-units');
    var label  = document.getElementById('ph-cd-label');
    var elD    = document.getElementById('ph-cd-d');
    var elH    = document.getElementById('ph-cd-h');
    var elM    = document.getElementById('ph-cd-m');
    var elS    = document.getElementById('ph-cd-s');
    if (!chip || !elD || !elH || !elM || !elS || !label) return;

    chip.style.display = 'inline-flex';

    if (now < ABFLUG) {
      var diff = ABFLUG.getTime() - now.getTime();
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      elD.textContent = d;
      elH.textContent = String(h).padStart(2, '0');
      elM.textContent = String(m).padStart(2, '0');
      elS.textContent = String(s).padStart(2, '0');
      label.textContent = 'bis Abflug';
      if (units) units.style.display = 'flex';
      chip.classList.remove('ph-chip-go');
    } else {
      var daysOn = Math.floor((now.getTime() - ABFLUG.getTime()) / 86400000);
      elD.textContent = daysOn;
      label.textContent = 'Tage unterwegs';
      // Stunden/Minuten/Sekunden nach Abflug ausblenden
      if (units) {
        var unitEls = units.querySelectorAll('.ph-cd-unit, .ph-cd-sep');
        unitEls.forEach(function(el, i) { if (i > 0) el.style.display = 'none'; });
      }
      chip.classList.add('ph-chip-go');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initTimeline(); initClock(); initWeather(); initExchangeRate(); updateCountdown(); setInterval(updateCountdown, 1000); });
  } else {
    initTimeline();
    initClock();
    initWeather();
    initExchangeRate();
    updateCountdown();
    setInterval(updateCountdown, 1000);
  }
})();
</script>

