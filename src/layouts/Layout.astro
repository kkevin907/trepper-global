---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Kevins Reise-Logbuch. Von Solingen nach Asien und weiter. Alle Stops, Food-Spots und was wirklich passiert ist.",
  ogImage = "/og-default.png",
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL   = new URL(ogImage, Astro.site);
const fullTitle    = title === "Home" ? "Trepper Global — Von Solingen in die Welt" : `${title} — Trepper Global`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Trepper Global" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale"      content="de_DE" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Leaflet JS synchron geladen damit window.L sofort verfügbar ist -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="8742655c-5cd6-46e5-975a-c6c96d5b58f6"></script>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          <span class="logo-dot"></span>
          Trepper Global
        </a>
        <div class="nav-links" id="nav-links">
          <a href="/jetzt" class:list={["nav-link nav-link-live", { active: currentPath === "/jetzt" }]}>
            <span class="nav-live-dot"></span>Jetzt
          </a>
          <a href="/orte" class:list={["nav-link", { active: currentPath.startsWith("/orte") }]}>Orte</a>
          <a href="/route" class:list={["nav-link", { active: currentPath === "/route" }]}>Route</a>
          <a href="/about" class:list={["nav-link", { active: currentPath === "/about" }]}>Über mich</a>
          <a href="/live-dabei" class:list={["nav-link nav-link--nl", { active: currentPath === "/live-dabei" }]}>Live dabei</a>
        </div>
        <button class="nav-burger" id="nav-burger" aria-label="Menü">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
    <script is:inline>
      var burger = document.getElementById('nav-burger');
      var links  = document.getElementById('nav-links');
      if (burger && links) {
        burger.addEventListener('click', function() {
          var open = links.classList.toggle('nav-links--open');
          burger.classList.toggle('nav-burger--open', open);
        });
        links.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() {
            links.classList.remove('nav-links--open');
            burger.classList.remove('nav-burger--open');
          });
        });
      }
    </script>

    <main>
      <slot />
    </main>

    <!-- Feedback Button + Modal -->
    <button class="fb-trigger" id="fb-trigger" aria-label="Feedback geben">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Feedback
    </button>

    <div class="fb-overlay" id="fb-overlay" aria-hidden="true">
      <div class="fb-modal" role="dialog" aria-modal="true" aria-labelledby="fb-title">
        <button class="fb-close" id="fb-close" aria-label="Schließen">✕</button>
        <h2 class="fb-title" id="fb-title">Feedback</h2>
        <p class="fb-sub">Was funktioniert nicht? Was könnte besser sein? Alles willkommen.</p>

        <form class="fb-form" id="fb-form" novalidate>
          <textarea
            id="fb-msg"
            name="nachricht"
            class="fb-textarea"
            placeholder="Dein Feedback..."
            rows="4"
            required
          ></textarea>
          <input
            type="email"
            id="fb-email"
            name="email"
            class="fb-input"
            placeholder="Deine E-Mail (optional)"
            autocomplete="email"
          />
          <button type="submit" class="fb-submit" id="fb-submit">
            <span class="fb-submit-text">Absenden</span>
            <span class="fb-submit-spinner" aria-hidden="true"></span>
          </button>
        </form>

        <div class="fb-success" id="fb-success">
          Danke! Ich schaue es mir an.
        </div>
      </div>
    </div>

    <footer class="footer">
      <div class="footer-inner">
        <span>Kevin Trepper · Unterwegs seit 2026</span>
        <div class="footer-right">
          <a href="mailto:kevin@trepper-global.de" class="footer-link">kevin@trepper-global.de</a>
          <a href="/impressum" class="footer-link">Impressum</a>
          <a href="/datenschutz" class="footer-link">Datenschutz</a>
          <a href="https://instagram.com/kevin.ontour" target="_blank" rel="noopener" class="footer-instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            Instagram
          </a>
          <a href="https://tiktok.com/@kevin.ontour" target="_blank" rel="noopener" class="footer-instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            TikTok
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  :root {
    --coral:        #F97316;
    --coral-light:  #FFF7ED;
    --coral-mid:    #FDBA74;
    --teal:         #0EA5E9;
    --teal-light:   #E0F2FE;
    --yellow:       #EAB308;
    --yellow-light: #FEF9C3;
    --green:        #10B981;
    --green-light:  #D1FAE5;
    --purple:       #8B5CF6;
    --purple-light: #EDE9FE;
    --pink:         #EC4899;
    --pink-light:   #FCE7F3;
    --text:         #0F172A;
    --text-mid:     #475569;
    --text-light:   #94A3B8;
    --border:       #E2E8F0;
    --bg:           #FFFFFF;
    --bg-soft:      #F8FAFC;
    --radius:       16px;
    --radius-sm:    10px;
    --shadow:       0 2px 12px rgba(15,23,42,0.08);
    --shadow-lg:    0 8px 32px rgba(15,23,42,0.14);
  }

  html {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    max-width: 100%;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    max-width: 100%;
    width: 100%;
  }
  main { flex: 1; }
  img  { max-width: 100%; height: auto; border-radius: var(--radius-sm); }

  a    { color: inherit; text-decoration: none; }

  /* ── SCROLL ANIMATIONS ──
     Elemente sind IMMER sichtbar. Sobald JS bereit ist,
     wird .js-ready auf <html> gesetzt und dann erst werden
     .reveal-Elemente versteckt und animiert eingeblendet.
     → Kein Risiko, dass Content unsichtbar bleibt.
  */
  .js-ready .reveal {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .js-ready .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger für .reveal-stagger Container */
  .js-ready .reveal-stagger > * {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .js-ready .reveal-stagger.in-view > *:nth-child(1) { transition-delay: 0.04s; }
  .js-ready .reveal-stagger.in-view > *:nth-child(2) { transition-delay: 0.12s; }
  .js-ready .reveal-stagger.in-view > *:nth-child(3) { transition-delay: 0.20s; }
  .js-ready .reveal-stagger.in-view > *:nth-child(4) { transition-delay: 0.28s; }
  .js-ready .reveal-stagger.in-view > *:nth-child(5) { transition-delay: 0.36s; }

  .js-ready .reveal-stagger.in-view > * {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<style>
  /* NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 200;
    background: rgba(255,255,255,0.94);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: -0.02em;
  }

  .logo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--coral);
    animation: logopulse 2.2s ease-in-out infinite;
  }

  @keyframes logopulse {
    0%, 100% { transform: scale(1);   opacity: 1; }
    50%       { transform: scale(1.4); opacity: 0.6; }
  }

  .nav-links { display: flex; gap: 0.2rem; align-items: center; }

  /* Hamburger */
  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    border-radius: 8px;
  }
  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform .2s, opacity .2s;
  }
  .nav-burger--open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger--open span:nth-child(2) { opacity: 0; }
  .nav-burger--open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 680px) {
    .nav-burger { display: flex; }
    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: rgba(255,255,255,0.98);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      padding: .75rem 1rem;
      gap: .25rem;
      z-index: 199;
    }
    .nav-links--open { display: flex; }
    .nav-link { padding: .75rem 1rem; border-radius: 10px; font-size: .95rem; }
    .nav { position: sticky; }
  }
  @media (max-width: 380px) {
    .nav-inner { padding: 0 1rem; }
  }

  .nav-link-live { display: inline-flex; align-items: center; gap: 5px; }
  .nav-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--coral);
    flex-shrink: 0;
    animation: livepulse 2s ease-in-out infinite;
  }
  @keyframes livepulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(249,115,22,.5); }
    50%      { box-shadow: 0 0 0 4px rgba(249,115,22,0); }
  }

  .nav-link {
    padding: 0.45rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-mid);
    transition: all 0.15s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--coral);
    background: var(--coral-light);
  }

  .nav-link--nl {
    background: var(--coral);
    color: white !important;
    font-weight: 700;
    padding: 0.4rem 1rem;
    border-radius: 8px;
    transition: background .15s, transform .15s;
  }
  .nav-link--nl:hover,
  .nav-link--nl.active {
    background: #EA6D10 !important;
    color: white !important;
  }

  /* FOOTER */
  .footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-light);
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-link {
    font-size: 0.85rem;
    color: var(--text-light);
    text-decoration: none;
    transition: color .15s;
  }
  .footer-link:hover { color: var(--coral); }

  .footer-instagram {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-light);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color .15s;
  }
  .footer-instagram:hover { color: var(--coral); }

  @media (max-width: 700px) {
    .footer {
      padding: 1.5rem 1rem;
      margin-top: 3rem;
    }
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .footer-right {
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .footer { padding: 1.25rem 1rem; margin-top: 2.5rem; }
    .footer-right { gap: 0.5rem 1rem; }
    .footer-link, .footer-instagram { font-size: 0.8rem; }
  }

  /* FEEDBACK */
  .fb-trigger {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 500;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: .5rem 1rem;
    background: var(--coral);
    color: white;
    border: none;
    border-radius: 100px;
    font-size: .82rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(249,115,22,.35);
    transition: transform .15s, box-shadow .15s;
  }
  .fb-trigger:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(249,115,22,.4); }

  .fb-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.45);
    z-index: 600;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .fb-overlay.open { display: flex; }

  .fb-modal {
    background: white;
    border-radius: 20px;
    padding: 2rem;
    width: 100%;
    max-width: 440px;
    position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,.2);
  }

  .fb-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1rem;
    color: var(--text-light);
    cursor: pointer;
    padding: .25rem .5rem;
    border-radius: 6px;
    line-height: 1;
  }
  .fb-close:hover { background: #F1F5F9; }

  .fb-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -.03em;
    color: var(--text);
    margin-bottom: .4rem;
  }
  .fb-sub {
    font-size: .85rem;
    color: var(--text-mid);
    margin-bottom: 1.25rem;
    line-height: 1.55;
  }

  .fb-form { display: flex; flex-direction: column; gap: .75rem; }

  .fb-textarea, .fb-input {
    width: 100%;
    padding: .75rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    font-size: .9rem;
    font-family: inherit;
    color: var(--text);
    background: white;
    outline: none;
    resize: vertical;
    transition: border-color .15s;
  }
  .fb-textarea:focus, .fb-input:focus {
    border-color: var(--coral);
    box-shadow: 0 0 0 3px rgba(249,115,22,.1);
  }
  .fb-textarea::placeholder, .fb-input::placeholder { color: #CBD5E1; }

  .fb-submit {
    padding: .75rem;
    background: var(--coral);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: .9rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: background .15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 44px;
  }
  .fb-submit:hover:not(:disabled) { background: #EA6A0A; }
  .fb-submit:disabled { opacity: .7; cursor: not-allowed; }

  .fb-submit-spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255,255,255,.4);
    border-top-color: white;
    border-radius: 50%;
    animation: fb-spin .6s linear infinite;
  }
  .fb-submit.loading .fb-submit-text { display: none; }
  .fb-submit.loading .fb-submit-spinner { display: block; }
  @keyframes fb-spin { to { transform: rotate(360deg); } }

  .fb-success {
    display: none;
    text-align: center;
    padding: 1rem;
    font-size: .95rem;
    font-weight: 700;
    color: #065F46;
    background: #ECFDF5;
    border: 1.5px solid #6EE7B7;
    border-radius: 12px;
    margin-top: .5rem;
  }
  .fb-success.visible { display: block; }

  @media (max-width: 480px) {
    .fb-trigger { bottom: 1rem; right: 1rem; font-size: .78rem; padding: .45rem .85rem; }
    .fb-modal { padding: 1.5rem; }
  }
</style>

<script is:inline>
  // Setzt .js-ready auf <html> und startet dann den Observer.
  // So ist Content ohne JS immer sichtbar.
  (function () {
    document.documentElement.classList.add('js-ready');

    function activate(el) {
      el.classList.add('in-view');
    }

    function initObserver() {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              activate(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -20px 0px' }
      );

      var els = document.querySelectorAll('.reveal, .reveal-stagger');
      els.forEach(function (el) {
        var rect = el.getBoundingClientRect();
        // Elemente die beim Laden schon sichtbar sind → sofort einblenden
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          setTimeout(function () { activate(el); }, 60);
        } else {
          observer.observe(el);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initObserver);
    } else {
      initObserver();
    }
  })();
</script>

<script is:inline>
  (function () {
    var trigger  = document.getElementById('fb-trigger');
    var overlay  = document.getElementById('fb-overlay');
    var closeBtn = document.getElementById('fb-close');
    var form     = document.getElementById('fb-form');
    var submit   = document.getElementById('fb-submit');
    var success  = document.getElementById('fb-success');

    function openModal()  { overlay.classList.add('open');    overlay.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; }
    function closeModal() { overlay.classList.remove('open'); overlay.setAttribute('aria-hidden','true');  document.body.style.overflow=''; }

    trigger?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', function(e) { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

    form?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var msg = document.getElementById('fb-msg').value.trim();
      if (!msg) return;

      submit.disabled = true;
      submit.classList.add('loading');

      try {
        await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nachricht: msg,
            email: document.getElementById('fb-email').value.trim()
          })
        }).catch(() => {});

        form.style.display = 'none';
        success.classList.add('visible');
        setTimeout(closeModal, 2500);
      } catch {
        form.style.display = 'none';
        success.classList.add('visible');
        setTimeout(closeModal, 2500);
      }
    });
  })();
</script>
